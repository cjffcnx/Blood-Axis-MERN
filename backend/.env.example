# Blood Bank Management System - Environment Variables
# Copy this file to .env and fill in your actual values

# ====================
# Server Configuration
# ====================
DEV_MODE=development
PORT=8080

# ====================
# MongoDB Configuration
# ====================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=blood_bank

# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# ====================
# Authentication
# ====================
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production
JWT_EXPIRE=7d

# ====================
# Email Configuration
# ====================
# EMAIL_PROVIDER=smtp

# Recommended for Render (HTTP API, more reliable than SMTP):
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM="Blood Bank <onboarding@resend.dev>"

# SMTP fallback (optional):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="Blood Bank <noreply@bloodbank.local>"

# ====================
# Client URL
# ====================
# CLIENT_URL=http://localhost:3000

# ====================
# Forecasting Configuration
# ====================

# Cron schedule for automatic forecasting
# Format: minute hour day_of_month month day_of_week
# Default: 0 2 * * * = 2 AM every day
FORECAST_SCHEDULE=0 2 * * *

# Log level: ERROR, WARN, INFO, DEBUG
LOG_LEVEL=INFO

# Number of days of historical data to use for forecasting (default: 180)
FORECAST_DAYS_BACK=180

# Whether to save forecast results to MongoDB (default: true)
FORECAST_SAVE_TO_DB=true

# ====================
# Payment Gateway (if using)
# ====================
# KHALTI_SECRET_KEY=your_khalti_secret_key
# ESEWA_MERCHANT_CODE=your_esewa_merchant_code

# ====================
# File Upload Configuration
# ====================
MAX_FILE_SIZE=5242880  # 5MB in bytes
UPLOAD_DIR=./uploads

# ====================
# Session/Security
# ====================
SESSION_SECRET=your_session_secret_key_change_this
# CORS_ORIGIN=http://localhost:3000

# ====================
# Notification (for future use)
# ====================
# NOTIFICATION_EMAIL_FROM=noreply@bloodbank.local
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ====================
# Analytics (for future use)
# ====================
# ANALYTICS_TRACKING_ID=your_tracking_id
